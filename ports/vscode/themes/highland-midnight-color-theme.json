  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#7A929C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#BE92DF"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type",
        "keyword.declaration",
        "keyword.function",
        "support.type.primitive",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#C6A46A"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#74A9EA"
      }
    },
    {
      "scope": [
        "string",
