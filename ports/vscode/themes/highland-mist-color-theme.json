        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#6A3893"
      }
    },
    {
      "scope": [
        "support.function.builtin",
        "support.function.magic"
      ],
      "settings": {
        "foreground": "#1D5BA6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "source.shell variable.other",
        "variable.other.normal.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": {
        "foreground": "#9D346F"
      }
    },
    {
      "scope": [
        "support.function.powershell",
        "support.function.cmdlet"
      ],
      "settings": {
        "foreground": "#1D5BA6"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#AE2F2A",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#9C4A0E",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#6E5C00",
    "class": "#6E5C00",
    "enum": "#6E5C00",
    "interface": "#6E5C00",
    "struct": "#6E5C00",
    "type": "#6E5C00",
    "typeParameter": {
      "foreground": "#6E5C00",
      "italic": true
    },
    "parameter": {
      "foreground": "#9D346F",
      "italic": true
    },
    "variable": "#0B1F2A",
    "variable.readonly": "#9C4A0E",
    "variable.defaultLibrary": "#AE2F2A",
    "property": "#0B6862",
    "enumMember": "#9C4A0E",
    "event": "#0B6862",
    "function": "#1D5BA6",
    "method": "#1D5BA6",
    "function.defaultLibrary": {
      "foreground": "#1D5BA6",
      "italic": true
    },
    "macro": "#9C4A0E",
    "label": "#6A3893",
    "comment": {
      "foreground": "#5A6C70",
      "italic": true
    },
    "string": "#2A6640",
    "keyword": "#6A3893",
    "number": "#9C4A0E",
    "regexp": "#0B6862",
    "operator": "#0B6862",
    "decorator": {
      "foreground": "#9C4A0E",
      "italic": true
    },
    "selfKeyword": {
      "foreground": "#AE2F2A",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
